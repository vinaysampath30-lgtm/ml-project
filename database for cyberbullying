        "import os\n",
        "import re\n",
        "import string\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from sklearn.model_selection import train_test_split, cross_val_score, StratifiedKFold\n",
        "from sklearn.feature_extraction.text import TfidfVectorizer\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.metrics import classification_report, confusion_matrix, accuracy_score, f1_score\n",
        "\n",
        "def generate_dataset():\n",
        "    print(\"[1/5] Generating synthetic Cyberbullying Detection dataset...\")\n",
        "    data = {\n",
        "        \"text\": [\n",
        "            # Age-based Bullying\n",
        "            \"You are too old to be on this platform, go to a nursing home grandpa\",\n",
        "            \"Look at this boomer trying to use tech, absolute dinosaur\",\n",
        "            \"Retire already old man, nobody wants to hear your ancient opinions\",\n",
        "            \"You look like a walking fossil, get off TikTok grandma\",\n",
        "            \"Why are senior citizens like you embarrassing yourselves online?\",\n",
        "            \"Go count your wrinkles and leave the internet to young people\",\n",
        "\n",
        "            # Gender / Sexism Bullying\n",
        "            \"Go back to the kitchen, girls shouldn't play competitive games\",\n",
        "            \"Women are incapable of understanding leadership or coding\",\n",
        "            \"She only got promoted because of diversity quotas, zero skill\",\n",
        "            \"Stop posting your face online, nobody wants to see ugly girls play\",\n",
        "            \"Female gamers are just attention seekers with no actual talent\",\n",
        "            \"Stick to makeup tutorials, serious discussions are for men\",\n",
        "\n",
        "            # Ethnicity / Racism Bullying\n",
        "            \"Go back to your country, you do not belong in this server\",\n",
        "            \"Your kind of people ruin everything in this community\",\n",
        "            \"Immigrants like you are destroying our culture, leave now\",\n",
        "            \"Stop speaking your weird language here, speak English or leave\",\n",
        "            \"You are an outsider and your people will never be accepted here\",\n",
        "            \"Typical behavior from someone of your background, totally disgusting\",\n",
        "\n",
        "            # Non-Bullying (Positive / Neutral Social Media Posts)\n",
        "            \"Great video! Thanks for sharing this helpful tutorial.\",\n",
        "            \"Had a wonderful time hanging out with friends today at the park.\",\n",
        "            \"Good luck to everyone taking exams this week! You got this.\",\n",
        "            \"Can anyone recommend a good laptop for machine learning and data science?\",\n",
        "            \"I love this new album, the production quality is amazing!\",\n",
        "            \"Happy birthday! Wishing you health, joy, and success ahead.\",\n",
        "            \"The sunset at the beach today was completely breathtaking.\",\n",
        "            \"Does anyone want to team up for the hackathon this weekend?\",\n",
        "            \"Just finished reading this amazing book on algorithms, highly recommended!\",\n",
        "            \"Learning React and Tailwind CSS has been an exciting journey so far.\"\n",
        "        ],\n",
        "        \"cyberbullying_type\": [\n",
        "            \"age\", \"age\", \"age\", \"age\", \"age\", \"age\",\n",
        "            \"gender\", \"gender\", \"gender\", \"gender\", \"gender\", \"gender\",\n",
        "            \"ethnicity\", \"ethnicity\", \"ethnicity\", \"ethnicity\", \"ethnicity\", \"ethnicity\",\n",
        "            \"not_bullying\", \"not_bullying\", \"not_bullying\", \"not_bullying\",\n",
        "            \"not_bullying\", \"not_bullying\", \"not_bullying\", \"not_bullying\",\n",
        "            \"not_bullying\", \"not_bullying\"\n",
        "        ]\n",
        "    }\n",
        "\n",
        "    df = pd.DataFrame(data)\n",
        "    # Augment/expand synthetic dataset with controlled noise/variations\n",
        "    df_expanded = pd.concat([df] * 20, ignore_index=True)\n",
        "\n",
        "    # Save raw dataset to CSV\n",
        "    os.makedirs(\"data\", exist_ok=True)\n",
        "    csv_path = os.path.join(\"data\", \"cyberbullying_dataset.csv\")\n",
        "    df_expanded.to_csv(csv_path, index=False)\n",
        "    print(f\"      Dataset successfully saved to: {csv_path} (Total samples: {len(df_expanded)})\")\n",
        "    return df_expanded\n",
        "\n",
        "def clean_text(text: str) -> str:\n",
        "    text = text.lower()\n",
        "    text = re.sub(r\"http\\S+|www\\S+|https\\S+\", \"\", text, flags=re.MULTILINE)\n",
        "    text = re.sub(r\"@\\w+|\\#\", \"\", text)\n",
        "    text = text.translate(str.maketrans(\"\", \"\", string.punctuation))\n",
        "    text = re.sub(r\"\\d+\", \"\", text)\n",
        "    text = re.sub(r\"\\s+\", \" \", text).strip()\n",
        "    return text\n",
        "\n",
        "def main():\n",
        "    print(\"=\" * 70)\n",
        "    print(\" CYBERBULLYING DETECTION ON SOCIAL MEDIA USING NLP & RANDOM FOREST\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    # 1. Dataset Generation\n",
        "    df = generate_dataset()\n",
        "\n",
        "    # 2. NLP Preprocessing\n",
        "    print(\"\\n[2/5] Performing NLP Text Preprocessing (Token Cleaning, Lowercasing, Regex)...\")\n",
        "    df[\"cleaned_text\"] = df[\"text\"].apply(clean_text)\n",
        "\n",
        "    # 3. Train-Test Split & TF-IDF Extraction\n",
        "    print(\"\\n[3/5] Extracting TF-IDF N-gram Features & Stratified Split...\")\n",
        "    X_train_raw, X_test_raw, y_train, y_test = train_test_split(\n",
        "        df[\"cleaned_text\"],\n",
        "        df[\"cyberbullying_type\"],\n",
        "        test_size=0.25,\n",
        "        random_state=42,\n",
        "        stratify=df[\"cyberbullying_type\"]\n",
        "    )\n",
        "\n",
        "    tfidf = TfidfVectorizer(ngram_range=(1, 2), max_features=1500, stop_words=\"english\")\n",
        "    X_train_tfidf = tfidf.fit_transform(X_train_raw)\n",
        "    X_test_tfidf = tfidf.transform(X_test_raw)\n",
        "    print(f\"      Vocabulary Size: {len(tfidf.get_feature_names_out())} features extracted.\")\n",
        "    print(f\"      Training shape: {X_train_tfidf.shape}, Test shape: {X_test_tfidf.shape}\")\n",
        "\n",
        "    # 4. Training Models (CO2 vs CO3)\n",
        "    print(\"\\n[4/5] Training Classifiers (Multinomial Logistic Regression vs Random Forest)...\")\n",
        "\n",
        "    # Model 1: Multinomial Logistic Regression (CO2)\n",
        "    log_reg = LogisticRegression(C=1.0, penalty=\"l2\", max_iter=200, random_state=42)\n",
        "    log_reg.fit(X_train_tfidf, y_train)\n",
        "    y_pred_log = log_reg.predict(X_test_tfidf)\n",
        "    acc_log = accuracy_score(y_test, y_pred_log)\n",
        "    f1_log = f1_score(y_test, y_pred_log, average=\"weighted\")\n",
        "\n",
        "    # Model 2: Random Forest Classifier (CO3)\n",
        "    rf_clf = RandomForestClassifier(\n",
        "        n_estimators=100,\n",
        "        criterion=\"gini\",\n",
        "        max_depth=15,\n",
        "        min_samples_split=2,\n",
        "        max_features=\"sqrt\",\n",
        "        random_state=42,\n",
        "        n_jobs=-1\n",
        "    )\n",
        "    rf_clf.fit(X_train_tfidf, y_train)\n",
        "    y_pred_rf = rf_clf.predict(X_test_tfidf)\n",
        "    acc_rf = accuracy_score(y_test, y_pred_rf)\n",
        "    f1_rf = f1_score(y_test, y_pred_rf, average=\"weighted\")\n",
        "\n",
        "    # 5. Performance Evaluation\n",
        "    print(\"\\n[5/5] Model Performance Comparison & Evaluation:\")\n",
        "    print(\"-\" * 70)\n",
        "    print(f\"  * Multinomial Logistic Regression (L2) -> Accuracy: {acc_log*100:.2f}%, Weighted F1: {f1_log:.4f}\")\n",
        "    print(f\"  * Random Forest Classifier (100 Trees)  -> Accuracy: {acc_rf*100:.2f}%, Weighted F1: {f1_rf:.4f}\")\n",
        "    print(\"-\" * 70)\n",
        "\n",
        "    print(\"\\n=== Detailed Classification Report (Random Forest) ===\")\n",
        "    print(classification_report(y_test, y_pred_rf))\n",
        "\n",
        "    # Feature Importance (CO3 - MDI / Gini Importance)\n",
        "    feature_names = np.array(tfidf.get_feature_names_out())\n",
        "    importances = rf_clf.feature_importances_\n",
        "    top_indices = np.argsort(importances)[::-1][:10]\n",
        "\n",
        "    print(\"\\n=== Top 10 Most Discriminative Bullying Features (MDI Gini Importance) ===\")\n",
        "    for rank, idx in enumerate(top_indices, 1):\n",
        "        print(f\"  {rank:2d}. '{feature_names[idx]}': Importance Score = {importances[idx]:.4f}\")\n",
        "\n",
        "    # Interactive Sample Predictions (Lifecycle Ingestion Simulation)\n",
        "    print(\"\\n=== Live Sample Inference Simulation ===\")\n",
        "    sample_texts = [\n",
        "        \"Grandpa should stop using social media and go to bed\",\n",
        "        \"Women should stay in the kitchen and stop trying to play ranked games\",\n",
        "        \"We are organizing a machine learning study group for students!\"\n",
        "    ]\n",
        "    cleaned_samples = [clean_text(t) for t in sample_texts]\n",
        "    sample_vectors = tfidf.transform(cleaned_samples)\n",
        "    predictions = rf_clf.predict(sample_vectors)\n",
        "    probabilities = rf_clf.predict_proba(sample_vectors)\n",
        "\n",
        "    for text, pred, prob in zip(sample_texts, predictions, probabilities):\n",
        "        max_p = np.max(prob) * 100\n",
        "        print(f\"  Text: \\\"{text}\\\"\")\n",
        "        print(f\"  --> Predicted Category: [{pred.upper()}] (Confidence: {max_p:.1f}%)\\n\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()\n"
      ]
    }
